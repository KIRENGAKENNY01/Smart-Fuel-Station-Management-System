{
  "name": "smart-fuel-station-management-system",
  "workspaces": [
    "Services/*",
    "api-gateway",
    "frontend",
    "shared"
  ],
  "version": "1.0.0",
  "description": "API Gateway for Smart Fuel Station Management System",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently \"npm:dev:*\"",
    "dev:auth": "npm run dev -w Services/auth-service",
    "dev:gateway": "npm run dev -w api-gateway",
    "dev:station": "npm run dev -w Services/station-service",
    "dev:fuel": "npm run dev -w Services/fuel-service",
    "dev:transaction": "npm run dev -w Services/transaction-service",
    "dev:frontend": "npm run dev -w frontend",
    "seed": "node seed.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14"
  }
}
